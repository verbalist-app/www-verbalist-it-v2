---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Content
const { name, description, url, logo } = {
  url: "/funzionalita/" + Astro.props.post.slug,
  name: Astro.props.post.data.name,
  description: Astro.props.post.data.description,
  logo: Astro.props.post.data.logo.url,
};
---

<div class="relative flex flex-col p-4 bg-white group bg-stripes">
  <a
    class="absolute inset-0 z-10"
    href={url}
    title={`Scopri ${name}`}
    aria-label={`Scopri ${name}`}></a>

  <div>
    <Image
      src={logo}
      alt={name}
      width={300}
      height={300}
      class="size-6"
    />
    <Text tag="h3" variant="textSM" class="font-medium text-base-950 mt-8">
      {name}
    </Text>
    <Text tag="p" variant="textXS" class="mt-2 text-base-600">
      {description}
    </Text>
    <Button
      iconOnly
      size="xs"
      variant="muted"
      href={url}
      default
      isLink={true}
      class="mt-24"
    >
      <ChevronRight slot="icon" size="sm" />
    </Button>
  </div>
</div>
