---
// Assets
import Cross from "@/components/assets/Cross.astro";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Chrome from "@/components/fundations/icons/Chrome.astro";
import FileDots from "@/components/fundations/icons/FileDots.astro";
import News from "@/components/fundations/icons/News.astro";
---

<section>
  <Wrapper
    variant="standard"
    class="relative pt-24 pb-8 border-t lg:pt-32 border-base-200"
  >
    <!-- Top Right Plus -->
    <Cross class="-top-[0.6rem] -right-[0.65rem]" />
    <!-- Top left Plus -->
    <Cross class="-top-[0.6rem] -left-[0.65rem]" />
    <StripesBG
      variant="base"
      class="absolute inset-0 mt-auto -mx-px border-t border-base-200 h-1/4"
    />
    <div class="relative max-w-2xl text-balance">
      <Text tag="h2" variant="displayMD" class="text-base-950 font-display">
        Si adatta al tuo brand, contenuto dopo contenuto
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-600">
        Verbalist apprende dai tuoi contenuti, dal tuo tono e dal tuo settore, senza condividerli con servizi esterni.
      </Text>
    </div>
    <div class="relative flex flex-col mt-12 gap-4">
      <!-- Sito web -->
      <div class="p-4 border-b border-base-200 bg-white">
        <div class="flex items-center justify-between">
          <div>
            <Text tag="h3" variant="textBase" class="text-base-950">Sito web</Text>
            <Text
              tag="p"
              variant="textXS"
              class="mt-2 text-base-600 text-balance"
            >
              Verbalist analizza le tue pagine pubbliche per assorbire stile, tono e terminologia.
            </Text>
          </div>
          <div class="flex items-center justify-center rounded-full size-11 bg-base-100 text-base-950 shrink-0">
            <Chrome size="sm" />
          </div>
        </div>
      </div>

      <!-- Documenti -->
      <div class="p-4 border-b border-base-200 bg-white">
        <div class="flex items-center justify-between">
          <div>
            <Text tag="h3" variant="textBase" class="text-base-950">Documenti</Text>
            <Text
              tag="p"
              variant="textXS"
              class="mt-2 text-base-600 text-balance"
            >
              Brand book, presentazioni, white paper: tutto ciò che descrive il tuo brand può essere caricato come riferimento.
            </Text>
          </div>
          <div class="flex items-center justify-center rounded-full size-11 bg-base-100 text-base-950 shrink-0">
            <FileDots size="sm" />
          </div>
        </div>
      </div>

      <!-- Contenuti passati -->
      <div class="p-4 border-b border-base-200 bg-white">
        <div class="flex items-center justify-between">
          <div>
            <Text tag="h3" variant="textBase" class="text-base-950">Contenuti passati</Text>
            <Text
              tag="p"
              variant="textXS"
              class="mt-2 text-base-600 text-balance"
            >
              Articoli e testi già pubblicati diventano la base per i nuovi, mantenendo coerenza editoriale.
            </Text>
          </div>
          <div class="flex items-center justify-center rounded-full size-11 bg-base-100 text-base-950 shrink-0">
            <News size="sm" />
          </div>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
