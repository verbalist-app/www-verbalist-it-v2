---
// Assets
import Cross from "@/components/assets/Cross.astro";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const features = [
  {
    bgClass: "bg-accent-horizontal-stripes",
    title: "Articoli per il blog",
    description:
      "Articoli che rispondono alle domande reali del tuo pubblico.",
  },
  {
    bgClass: "bg-base-horizontal-stripes",
    title: "Schede prodotto",
    description:
      "Descrizioni e benefici scritti per chi sta valutando l'acquisto.",
  },
  {
    bgClass: "bg-light-horizontal-stripes",
    title: "Guide pratiche",
    description:
      "Tutorial e how-to che accompagnano l'utente passo dopo passo.",
  },
  {
    bgClass: "bg-meshPurple",
    title: "Landing page",
    description:
      "Pagine costruite intorno a keyword, intenti e CTA chiare.",
  },
];
---

<section id="come-funziona" class="scroll-mt-24">
  <Wrapper
    variant="standard"
    class="relative pt-24 pb-8 border-t lg:pt-32 border-base-200"
  >
    <!-- Top Right Plus -->
    <Cross class="-top-[0.6rem] -right-[0.65rem]" />
    <!-- Top left Plus -->
    <Cross class="-top-[0.6rem] -left-[0.65rem]" />
    <StripesBG
      variant="base"
      class="absolute inset-0 mt-auto -mx-px border-t border-base-200 h-1/5"
    />
    <div class="relative max-w-2xl mx-auto text-center text-balance">
      <Text tag="h2" variant="displayMD" class="text-base-950 font-display">
        Genera contenuti per ogni formato, ottimizzati per Google e per le 
        AI search
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-600">
        Che sia un articolo che risponde a una domanda, una scheda prodotto 
        che convince, una guida passo passo o una landing che converte: 
        ogni contenuto nasce da quello che le persone cercano davvero su Google e sulle AI.
      </Text>
    </div>
    <div
      class="relative mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px"
    >
      {
        features.map((feature) => (
          <div class="flex flex-col justify-between h-full">
            <div class={`aspect-12/8  ${feature.bgClass}`} />
            <div class="h-full p-4 pb-24  bg-white">
              <Text tag="h3" variant="textBase" class="text-base-950 ">
                {feature.title}
              </Text>
              <Text tag="p" variant="textSM" class="mt-2  text-base-600">
                {feature.description}
              </Text>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
