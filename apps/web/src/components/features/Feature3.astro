---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";

const features = [
  {
    bgClass: "bg-accent-vertical-stripes",
    title: "Più tool in un unico flusso",
    description:
      "SERP, intenti, gap di copertura: analisi che con un AI generico richiedono più tool, qui sono integrate.",
  },
  {
    bgClass: "bg-meshMagenta",
    title: "Più contenuti, stesso standard",
    description:
      "Pubblichi di più senza rinunciare a coerenza, struttura e qualità editoriale: la produzione cresce, lo standard resta.",
  },
];
---

<section>
  <div
    class="relative text-center border-t grid grid-cols-1 md:grid-cols-2 gap-px text-balance border-base-200"
  >
    {
      features.map((feature) => (
        <div class="flex flex-col h-full overflow-hidden bg-white">
          <div class="px-4 pt-24 pb-8 lg:pt-32 ">
            <Text tag="h2" variant="displayMD" class="text-base-950 font-display">
              {feature.title}
            </Text>
            <Text tag="p" variant="textBase" class="mt-4 text-base-600">
              {feature.description}
            </Text>
          </div>
          <div class={`aspect-12/8 -mx-px p-4 ${feature.bgClass}`} />
        </div>
      ))
    }
  </div>
</section>
