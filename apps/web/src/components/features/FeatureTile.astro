---
// Assets
import { Image } from "astro:assets";

// Content
const { name, url, logo } = {
  url: "/funzionalita/" + Astro.props.post.slug,
  name: Astro.props.post.data.name,
  logo: Astro.props.post.data.logo.url,
};
---

<div
  class="relative flex flex-col items-center justify-center p-8 bg-white aspect-square group bg-stripes"
>
  <a
    class="absolute inset-0 z-10"
    href={url}
    title={`Scopri ${name}`}
    aria-label={`Scopri ${name}`}></a>

  <Image
    src={logo}
    alt={name}
    width={300}
    height={300}
    class="size-6 lg:size-8 grayscale group-hover:grayscale-0 duration-300"
  />
</div>
