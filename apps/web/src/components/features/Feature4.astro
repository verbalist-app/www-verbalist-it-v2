---
// Assets
import Cross from "@/components/assets/Cross.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const features = [
  {
    bgClass: "bg-meshMagenta",
    title: "Più lingue, stesso brand",
    description:
      "Genera contenuti in più lingue mantenendo coerenza di tono, struttura e dati di ricerca.",
  },
  {
    bgClass: "bg-base-vertical-stripes",
    title: "Fact-checking integrato",
    description:
      "Ogni affermazione è collegata a fonti verificate e citate, riducendo errori e aumentando l'affidabilità.",
  },
  {
    bgClass: "bg-meshGreen",
    title: "Brief automatico, prima del testo",
    description:
      "Verbalist costruisce il brief di ogni contenuto (keyword, intenti, struttura, fonti) prima della scrittura.",
  },
  {
    bgClass: "bg-light-vertical-stripes",
    title: "Analisi SERP integrata",
    description:
      "L'analisi competitiva e la SERP fanno parte del flusso, non un passaggio da incollare a mano.",
  },
  {
    bgClass: "bg-accent-vertical-stripes",
    title: "Aggiorni i contenuti già pubblicati",
    description:
      "Rinfreschi i tuoi articoli quando la SERP cambia, mantenendoli rilevanti senza riscriverli da zero.",
  },
  {
    bgClass: "bg-meshLightBlue",
    title: "Lavori in team, con ruoli",
    description:
      "Più persone, ruoli e permessi sullo stesso progetto: SEO, editor e copywriter, ognuno il suo accesso.",
  },
];
---

<section>
  <Wrapper
    variant="standard"
    class="relative pt-24 pb-8 border-t lg:pt-32 border-base-200"
  >
    <!-- Top Right Plus -->
    <Cross class="-top-[0.6rem] -right-[0.65rem]" />
    <!-- Top left Plus -->
    <Cross class="-top-[0.6rem] -left-[0.65rem]" />
    <div class="relative max-w-2xl text-balance">
      <Text tag="h2" variant="displayMD" class="text-base-950 font-display">
        Pensato per chi produce contenuti
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-600">
        Da multilingua a fact-checking, ogni funzionalità è pensata per chi crea contenuti professionalmente.
      </Text>
      <div class="flex flex-wrap items-center w-full mt-8 gap-2">
        <Button href="#_" isLink={true} size="xs" variant="alternative"
          >Inizia ora</Button
        >
        <Button size="xs" variant="muted" isLink={true} href="#_"
          >Vedi tutte le funzionalità</Button
        >
      </div>
    </div>
  </Wrapper>
  <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px">
    {
      features.map((feature) => (
        <div class="flex flex-col justify-between h-full overflow-hidden">
          <div class=" h-full flex flex-col p-4 pt-24 bg-white">
            <Text tag="h3" variant="textBase" class="text-base-950 ">
              {feature.title}
            </Text>
            <Text tag="p" variant="textSM" class=" text-base-600">
              {feature.description}
            </Text>
          </div>
          <div class={`aspect-12/8 p-4 -mx-px ${feature.bgClass}`} />
        </div>
      ))
    }
  </div>
</section>
