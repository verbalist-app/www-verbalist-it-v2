---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title?: string;
  description?: string;
  image?: {
    url: string;
    alt?: string;
  };
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title: pageTitle,
  description: pageDescription,
  image: pageImage,
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

// Verbalist global defaults
const SITE_TITLE = "Verbalist";
const SITE_DESCRIPTION =
  "Crea contenuti SEO a partire dai dati di ricerca, ottimizzati per Google e per le AI search.";
const SITE_URL = "https://www.verbalist.it";
const DEFAULT_OG_IMAGE = "/og-image.jpg";
const TWITTER_HANDLE = "";

const title = pageTitle ? `${pageTitle} | ${SITE_TITLE}` : SITE_TITLE;
const description = pageDescription || SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();

const ogImageUrl = pageImage?.url || DEFAULT_OG_IMAGE;
const ogImageAlt = pageImage?.alt || title;
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  openGraph={{
    url: canonical,
    title: title,
    description: description,
    images: [
      {
        url: new URL(ogImageUrl, SITE_URL).toString(),
        width: 1200,
        height: 630,
        alt: ogImageAlt,
        type: "image/jpeg",
      },
    ],
    site_name: SITE_TITLE,
    type: type,
    locale: "it_IT",
    ...(type === "article" &&
      publishedTime && {
        article: {
          publishedTime: publishedTime,
        },
      }),
  }}
  twitter={{
    handle: TWITTER_HANDLE,
    site: TWITTER_HANDLE,
    cardType: "summary_large_image",
  }}
/>
