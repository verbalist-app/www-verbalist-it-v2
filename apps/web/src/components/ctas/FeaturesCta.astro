---
// Assets
import Cross from "@/components/assets/Cross.astro";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import FeatureTile from "@/components/features/FeatureTile.astro";
// Features Content
import { getAllFeatures } from "@/lib/data";
const allFeatures = (await getAllFeatures()).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
---

<Wrapper variant="paddinglessDesktop" class="relative border-t border-base-200">
  <!-- Top Right Plus -->
  <Cross class="-top-[0.7rem] -right-[0.65rem]" />
  <!-- Top left Plus -->
  <Cross class="-top-[0.7rem] -left-[0.65rem]" />
  <StripesBG
    aria-hidden="true"
    variant="base"
    direction="horizontal"
    class="absolute inset-0 mt-auto -mx-px lg:w-1/2 lg:ml-auto lg:border-l lg:border-base-200"
  />

  <div class="relative items-center grid grid-cols-1 lg:grid-cols-2">
    <div class="p-8 text-balance">
      <Text
        tag="h2"
        variant="displayMD"
        class="max-w-md text-base-950 font-display"
      >
        Cosa lo distingue davvero da altri strumenti
      </Text>

      <Button
        isLink={true}
        size="xs"
        variant="accent"
        href="/funzionalita/"
        class="mt-8 w-fit"
      >
        Vedi tutte le funzionalità
      </Button>
    </div>
    <div class="p-8 grid grid-cols-3 gap-4">
      {
        allFeatures
          .slice(0, 6)
          .map((post) => <FeatureTile post={post} />)
      }
    </div>
  </div>
</Wrapper>
