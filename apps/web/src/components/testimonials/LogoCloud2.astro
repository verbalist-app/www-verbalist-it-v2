---
const logos = [
  { src: "/logos/jurny.svg", alt: "Jurny" },
  { src: "/logos/pompea.svg", alt: "Pompea" },
  { src: "/logos/rentokil.svg", alt: "Rentokil" },
  { src: "/logos/meccanotecnica.svg", alt: "Meccanotecnica" },
  { src: "/logos/plastisac.svg", alt: "Plastisac" },
  { src: "/logos/sogese.svg", alt: "Sogese" },
];
---

<section class="overflow-hidden">
  <div class="relative flex w-max animate-marquee">
    {[false, true].map((isDuplicate) => (
      <div
        class="flex shrink-0 items-center gap-12 pr-12 lg:gap-24 lg:pr-24"
        aria-hidden={isDuplicate ? "true" : undefined}
      >
        {logos.map((logo) => (
          <div
            role={isDuplicate ? undefined : "img"}
            aria-label={isDuplicate ? undefined : logo.alt}
            class="h-7 w-24 bg-base-950"
            style={{
              mask: `url(${logo.src}) no-repeat center / contain`,
              WebkitMask: `url(${logo.src}) no-repeat center / contain`,
            }}
          />
        ))}
      </div>
    ))}
  </div>
</section>
