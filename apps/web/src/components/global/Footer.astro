---
// Assets
import Logo from "@/components/assets/Logo.astro";

// Fundatons
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const footerLinks = [
  {
    heading: "Prodotto",
    links: [
      { label: "Funzionalità", href: "/funzionalita/home" },
      { label: "Prezzi", href: "/#prezzi" },
      { label: "Changelog", href: "/changelog/home" },
    ],
  },
  {
    heading: "Risorse",
    links: [
      { label: "Blog", href: "/blog/home" },
      { label: "Help center", href: "/helpcenter/home" },
      { label: "Customer stories", href: "/customers/home" },
    ],
  },
  {
    heading: "Azienda",
    links: [
      { label: "Chi siamo", href: "/about" },
      { label: "Team", href: "/team/home" },
      { label: "Contatti", href: "/forms/contact" },
    ],
  },
  {
    heading: "Legale",
    links: [
      { label: "Privacy", href: "/infopages/privacy" },
      { label: "Termini", href: "/infopages/privacy" },
    ],
  },
];
---

<footer>
  <Wrapper
    variant="paddinglessDesktop"
    class="relative py-12 overflow-hidden border-base-200 borderb"
  >
    <div class="relative pb-24 gap-8 grid grid-cols-1 lg:grid-cols-3">
      <div class="text-base-950">
        <a href="/" class="flex items-center text-sm text-base-950 gap-2">
          <span class="sr-only">Vai alla homepage</span>
          <Logo class="h-6" />
          Verbalist
        </a>
        <p class="mt-1 text-sm font-normal text-base-600 text-balance">
          Crea contenuti SEO a partire dai dati di ricerca, ottimizzati
          per Google e per le AI search.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-8 xl:col-span-2 xl:col-start-3">
        {
          footerLinks.map((section) => (
            <div>
              <Text tag="h3" variant="textBase" class="text-base-950 font-display">
                {section.heading}
              </Text>
              <ul role="list" class="mt-2 text-sm space-y-1 text-base-600">
                {section.links.map((link) => (
                  <li>
                    <a
                      title="Button to your page"
                      aria-label="your label"
                      href={link.href}
                      class="hover:text-base-950"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    
    <div aria-hidden="true" class="bg-base-vertical-stripes p-20 clip-rect-inset lg:py-62 mt-12"></div>
  </Wrapper>
</footer>
