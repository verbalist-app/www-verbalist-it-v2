---
// Assets
import Cross from "@/components/assets/Cross.astro";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";
---

<section>
  <Wrapper variant="standard" class="relative pt-32 pb-12">
    <!-- Top Right Plus -->
    <Cross class="-top-[0.6rem] -right-[0.65rem] z-51" />
    <!-- Top left Plus -->
    <Cross class="-top-[0.6rem] -left-[0.65rem] z-51" />
    <StripesBG
      variant="base"
      class="absolute inset-0 h-24 p-20 mt-auto -mx-px border-t border-base-200"
    />
    <div class="relative text-center text-balance">
      <Text
        tag="h1"
        variant="displayXL"
        class="tracking-tight text-base-950 font-display"
      >
        Crea contenuti<br>a partire dai dati di ricerca
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="max-w-xl mx-auto mt-4 text-base-600"
      >
        Verbalist trasforma keyword, risultati Google e competitor in contenuti SEO strutturati, 
        completi e pronti anche per la ricerca con AI.
      </Text>
      <div class="flex flex-wrap items-center justify-center w-full mt-8 gap-2">
        <Button href="/forms/contact" isLink={true} size="xs" variant="alternative"
          >Prenota demo</Button
        >
        <Button size="xs" variant="muted" isLink={true} href="#come-funziona"
          >Come funziona</Button
        >
      </div>
    </div>
    <div class="relative">
      <div
        class="absolute inset-0 max-w-2xl mx-auto bg-white/30 blur animate-pulse"
      >
      </div>
      <div
        class="relative max-w-2xl p-2 mx-auto mt-8 text-gray-900 rounded-lg shadow-dimensional bg-white"
      >
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Inserisci una keyword, un URL o un documento..."
          class="block w-full px-4 py-2 font-mono text-sm leading-tight text-base-950 align-middle bg-transparent border border-transparent resize-none transition duration-300 ease-in-out focus:z-10 rounded-md placeholder-base-400 focus:outline-none focus:border-transparent focus:ring-0 scrollbar-hide"
        ></textarea>
        <div class="grid grid-cols-1 md:flex gap-1 md:items-center">
          <Button size="xs" variant="muted" class="w-full md:w-fit">
            Articolo di blog
          </Button>
          <Button size="xs" variant="muted" class="w-full md:w-fit">
            Landing page
          </Button>
          <Button size="xs" variant="muted" class="w-full md:w-fit">
            Scheda prodotto
          </Button>
          <Button iconOnly size="xs" variant="muted">
            <ArrowRight slot="icon" size="xs" />
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
