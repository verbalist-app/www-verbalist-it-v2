---
// Assets
import Cross from "@/components/assets/Cross.astro";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Component
import BlogEntry from "@/components/blog/BlogEntry.astro";
import BlogSearch from "@/components/blog/BlogSearch.astro";
// Content
import { getAllPosts } from "@/lib/data";
const allPostsUnsorted = await getAllPosts();
const allPosts = allPostsUnsorted.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = [
  { value: "all", label: "Tutti" },
  { value: "ai-automation", label: "AI & Automation" },
  { value: "guide", label: "Guide" },
  { value: "seo", label: "SEO" },
];

const seo = {
  title: "Blog",
  description:
    "Articoli e guide su SEO, GEO e generative engine optimization, scritti dal team Verbalist.",
};
---

<BaseLayout seo={seo}>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-12 relative">
      <Cross class="-top-[0.6rem] -right-[0.65rem] z-51" />
      <Cross class="-top-[0.6rem] -left-[0.65rem] z-51" />
      <StripesBG
        variant="accent"
        class="hidden lg:block absolute inset-0 h-full -mx-px lg:w-[50%] ml-auto clip-rect-inset"
      />
      <div class="text-balance max-w-xl relative">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-medium tracking-tight text-base-950"
        >
          Blog
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-600">
          Articoli e guide su SEO, GEO e generative engine optimization,
          scritti dal team Verbalist.
        </Text>
      </div>
    </Wrapper>
    <div
      class="flex items-center gap-2 border-t border-base-200 px-8 py-4"
    >
      <BlogSearch />
      <div
        role="tablist"
        aria-label="Filtra articoli per categoria"
        class="relative flex items-center overflow-x-auto gap-2 py-2 scrollable-content snap-x snap-proximity scrollbar-hide"
      >
        {
          categories.map((cat, i) => (
            <Button
              size="xs"
              variant="muted"
              data-filter={cat.value}
              aria-pressed={i === 0 ? "true" : "false"}
              class={`blog-filter capitalize ${i === 0 ? "text-base-950" : "text-base-500"}`}
            >
              {cat.label}
            </Button>
          ))
        }
      </div>
    </div>
    <div
      id="blog-grid"
      class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px border-t border-base-200"
    >
      {allPosts.map((post) => <BlogEntry post={post} />)}
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>(".blog-filter");
    const entries = document.querySelectorAll<HTMLElement>(".blog-entry");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter ?? "all";

        // Toggle active state on buttons (subtle: text color only)
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", active ? "true" : "false");
          b.classList.toggle("text-base-950", active);
          b.classList.toggle("text-base-500", !active);
        });

        // Show / hide entries
        entries.forEach((entry) => {
          const cat = entry.dataset.category;
          const show = filter === "all" || cat === filter;
          entry.style.display = show ? "" : "none";
        });
      });
    });
  });
</script>
