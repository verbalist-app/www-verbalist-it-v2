---
// Assets
import { Image } from "astro:assets";
import Team1 from "@/images/assets/about-1.jpg";
import Team2 from "@/images/assets/about-2.jpg";
import Team3 from "@/images/assets/about-3.jpg";
import Team4 from "@/images/assets/about-4.png";
// Assets

// import the logos
import investor1 from "@/images/investors/1.svg";
import investor2 from "@/images/investors/2.svg";
import investor3 from "@/images/investors/3.svg";
import investor4 from "@/images/investors/4.svg";
import investor5 from "@/images/investors/5.svg";
import investor6 from "@/images/investors/6.svg";
// TODO: sostituire i 6 SVG placeholder con i loghi reali dei clienti
// enterprise (EY, Mercedes-Benz, LVMH, SDA Bocconi…). I file vivono in
// `apps/web/src/images/investors/` — vanno semplicemente sostituiti
// mantenendo i nomi 1.svg–6.svg, oppure rinominati e aggiornati qui.
const logos = [
  { bgClass: "bg-accent-vertical-stripes", src: investor1, alt: "Cliente enterprise" },
  { bgClass: "bg-meshGreen", src: investor2, alt: "Cliente enterprise" },
  { bgClass: "bg-accent-vertical-stripes", src: investor3, alt: "Cliente enterprise" },
  { bgClass: "bg-meshRainbow", src: investor4, alt: "Cliente enterprise" },
  { bgClass: "bg-light-vertical-stripes", src: investor5, alt: "Cliente enterprise" },
  { bgClass: "bg-meshPurple", src: investor6, alt: "Cliente enterprise" },
];

import Cross from "@/components/assets/Cross.astro";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="relative pt-32 pb-12">
      <!-- Top Right Plus -->
      <Cross class="-top-[0.6rem] -right-[0.65rem] z-51" />
      <!-- Top left Plus -->
      <Cross class="-top-[0.6rem] -left-[0.65rem] z-51" />
      <StripesBG
        variant="base"
        class="absolute inset-0 p-20 mt-auto -mx-px border-t border-base-200 h-1/3"
      />
      <div class="relative max-w-md mx-auto">
        <Text
          tag="h1"
          variant="displaySM"
          class="tracking-tight text-base-950 font-display text-balance"
        >
          25 anni di esperienza SEO, in un software
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="max-w-xl mx-auto mt-4 text-base-600"
        >
          Verbalist è il prodotto di NUR Digital Marketing. Dal 1999 lavoriamo
          con team marketing italiani e internazionali. Oggi le metodologie
          SEO che usiamo per loro sono accessibili a chiunque.
        </Text>
        <Button
          href="https://share-eu1.hsforms.com/1QmfwKDraSVOGP3_N6WSMHAft3vh"
          isLink={true}
          size="xs"
          variant="alternative"
          class="mt-8 w-fit">Prenota demo</Button
        >
      </div>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <div class="relative">
          <div class="absolute inset-0 bg-meshLightBlue mix-blend-hard-light">
          </div>
          <Image src={Team1} alt="Team1" class="object-cover w-full h-full" />
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-meshMagenta mix-blend-hard-light">
          </div>
          <Image src={Team2} alt="Team2" class="object-cover w-full h-full" />
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-meshPurple mix-blend-hard-light">
          </div>
          <Image src={Team3} alt="Team3" class="object-cover w-full h-full" />
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-meshGreen mix-blend-hard-light"></div>
          <Image src={Team4} alt="Team4" class="object-cover w-full h-full" />
        </div>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper
      variant="paddinglessDesktop"
      class="relative overflow-hidden border-t border-base-200"
    >
      <div class="relative grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="px-4 py-8">
          <Text tag="h2" variant="displayMD" class="text-base-950 font-display">
            Costruito sull'esperienza con i grandi brand
          </Text>
          <Text tag="p" variant="textBase" class="mt-4 text-base-600">
            Lavoriamo con EY, Mercedes-Benz, LVMH e SDA Bocconi. Verbalist
            automatizza le metodologie testate su migliaia di campagne reali,
            tra cui i primi servizi GEO disponibili in Italia.
          </Text>
        </div>
        <div
          class="relative lg:col-span-2 grid grid-cols-1 gap-px lg:grid-cols-3"
        >
          {
            logos.map((logo) => (
              <div class="relative flex flex-col items-center justify-center p-8 aspect-square group bg-stripes">
                <div
                  class={`absolute inset-0 z-10 clip-rect-inset ${logo.bgClass}`}
                />
                <Image
                  width={200}
                  height={100}
                  src={logo.src}
                  alt={logo.alt}
                  class="relative size-8 lg:size-20"
                />
              </div>
            ))
          }
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
