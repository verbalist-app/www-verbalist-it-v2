---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Sections
import LogoCloud2 from "@/components/testimonials/LogoCloud2.astro";
// Icons
import GoogleColor from "@/components/fundations/icons/GoogleColor.astro";
const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL ?? "/dashboard";
const backgrounds = [
  "bg-meshMagenta",
  "bg-base-vertical-stripes",
  "bg-accent-horizontal-stripes",
  "bg-white",
  "bg-base-horizontal-stripes",
  "bg-meshGreen",
  "bg-light-vertical-stripes",
  "bg-white",
  "bg-base-vertical-stripes",
  "bg-meshMagenta",
  "bg-accent-horizontal-stripes",
  "bg-white",
  "bg-white",
  "bg-base-horizontal-stripes",
  "bg-meshGreen",
  "bg-light-vertical-stripes",
  "bg-white",
  "bg-accent-horizontal-stripes",
];
---

<BaseLayout>
  <div class="flex overflow-hidden border-t border-base-200 bg-white">
    <div
      class="relative flex flex-col items-center justify-center w-full py-8 lg:w-2/3"
    >
      <div class="relative w-full max-w-md pt-12">
        <div>
          <Text
            tag="h1"
            variant="displayMD"
            class="font-medium tracking-tight text-base-950"
          >
            Sign up
          </Text>
          <Text
            tag="p"
            variant="textBase"
            class="max-w-xl mx-auto mt-4 text-base-600"
          >
            reate your account below. We promise not to make you confirm your
            email three times (unless you really want to).
          </Text>
        </div>
        <!-- DEMO BANNER — rimuovere quando l'auth vera è integrata -->
        <div
          class="relative mt-6 px-4 py-3 text-xs leading-relaxed text-base-700 rounded-md bg-accent-50 border border-accent-100"
        >
          <p class="font-medium text-accent-700">Demo account</p>
          <p class="mt-1">
            Form senza backend reale: clicca "Create account" per entrare nella dashboard.
          </p>
        </div>
        <!-- /DEMO BANNER -->
        <form id="sign-up-form" data-redirect={dashboardUrl} class="mt-6 space-y-4">
          <div class="w-full">
            <div class="flex items-baseline justify-between mb-1">
              <label for="email" class="text-sm font-medium text-base-600">
                Email Address
              </label>
            </div>
            <div class="relative z-0 focus-within:z-10">
              <input
                id="email"
                name="email"
                type="email"
                placeholder="you@example.com"
                value="demo@verbalist.it"
                class="block w-full px-4 py-2 text-xs leading-tight align-middle border border-transparent bg-white transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-600 ring-1 ring-base-200 placeholder-base-400 focus:border-accent-500 focus:ring-accent-600 focus:ring-2 focus:outline-none shadow-sm"
                inputmode="email"
              />
            </div>
          </div>
          <div class="w-full">
            <div class="flex items-baseline justify-between mb-1">
              <label for="password" class="text-sm font-medium text-base-600">
                Password
              </label>
            </div>
            <div class="relative z-0 focus-within:z-10">
              <input
                required
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                value="demo"
                class="block w-full px-4 py-2 text-xs leading-tight align-middle border border-transparent bg-white transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-600 ring-1 ring-base-200 placeholder-base-400 focus:border-accent-500 focus:ring-accent-600 focus:ring-2 focus:outline-none shadow-sm"
                aria-required="true"
              />
            </div>
          </div>
          <div class="w-full">
            <div class="flex items-baseline justify-between mb-1">
              <label
                for="confirm-password"
                class="text-sm font-medium text-base-600"
              >
                Confirm Password
              </label>
            </div>
            <div class="relative z-0 focus-within:z-10">
              <input
                required
                id="confirm-password"
                name="confirm-password"
                type="password"
                placeholder="••••••••"
                value="demo"
                class="block w-full px-4 py-2 text-xs leading-tight align-middle border border-transparent bg-white transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-600 ring-1 ring-base-200 placeholder-base-400 focus:border-accent-500 focus:ring-accent-600 focus:ring-2 focus:outline-none shadow-sm"
                aria-required="true"
              />
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <Button size="base" variant="accent" gap="sm" type="submit">
              Create account
            </Button>
            <Button size="base" variant="muted" gap="sm" type="button">
              <GoogleColor />
              Sign up with Google
            </Button>
          </div>
        </form>
        <p class="mt-4 text-xs font-medium text-base-600">
          Already have an account?
          <a
            href="/forms/sign-in"
            class="font-medium text-accent-500 hover:text-base-600"
          >
            Sign in
          </a>
        </p>
      </div>
      <div class="flex items-center justify-center w-full mt-24 gap-8">
        <LogoCloud2 />
      </div>
    </div>
    <div
      class="relative hidden overflow-hidden border-l lg:block lg:w-1/3 border-base-200"
    >
      <div class="grid grid-cols-3">
        {
          backgrounds.map((bg) => (
            <div
              aria-hidden="true"
              class={`pointer-events-none ${bg} size-full aspect-square`}
            />
          ))
        }
      </div>
    </div>
  </div>
  <script>
    const form = document.getElementById("sign-up-form") as HTMLFormElement | null;
    if (form) {
      const redirect = form.dataset.redirect ?? "/dashboard";
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        window.location.href = redirect;
      });
    }
  </script>
</BaseLayout>
