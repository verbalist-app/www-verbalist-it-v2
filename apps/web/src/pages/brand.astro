---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Logo components
import Logo from "@/components/assets/Logo.astro";
import LogoMark from "@/components/assets/LogoMark.astro";
import Wallpaper from "@/components/assets/Wallpaper.astro";

// SEO
const seo = {
  title: "Brand kit",
  description:
    "Logotipo, marchio, palette colori, tipografia e regole d'uso del brand Verbalist. Risorse per il team di comunicazione, marketing e design.",
  noindex: true,
};

// Logo variants (per le card di anteprima e download)
const logoVariants = [
  {
    label: "Logotipo, versione scura",
    download: "/brand/verbalist-logotype-dark.svg",
    bg: "bg-mist-50",
    text: "text-mist-950",
    component: "logotype",
    fileName: "verbalist-logotype-dark.svg",
  },
  {
    label: "Logotipo, versione chiara",
    download: "/brand/verbalist-logotype-light.svg",
    bg: "bg-mist-950",
    text: "text-mist-50",
    component: "logotype",
    fileName: "verbalist-logotype-light.svg",
  },
  {
    label: "Marchio, versione scura",
    download: "/brand/verbalist-mark-dark.svg",
    bg: "bg-mist-50",
    text: "text-mist-950",
    component: "mark",
    fileName: "verbalist-mark-dark.svg",
  },
  {
    label: "Marchio, versione chiara",
    download: "/brand/verbalist-mark-light.svg",
    bg: "bg-mist-950",
    text: "text-mist-50",
    component: "mark",
    fileName: "verbalist-mark-light.svg",
  },
];

// Palette Mist — unica famiglia (sostituisce accent + base)
const mistPalette = [
  { name: "mist-50", hex: "#F8FAFA", oklch: "oklch(98.7% 0.002 197.1)", swatch: "bg-mist-50" },
  { name: "mist-100", hex: "#F0F2F2", oklch: "oklch(96.3% 0.002 197.1)", swatch: "bg-mist-100" },
  { name: "mist-200", hex: "#E1E5E7", oklch: "oklch(92.5% 0.005 214.3)", swatch: "bg-mist-200" },
  { name: "mist-300", hex: "#CDD3D6", oklch: "oklch(87.2% 0.007 219.6)", swatch: "bg-mist-300" },
  { name: "mist-400", hex: "#9DA8AD", oklch: "oklch(72.3% 0.014 214.4)", swatch: "bg-mist-400" },
  { name: "mist-500", hex: "#6F7C82", oklch: "oklch(56% 0.021 213.5)", swatch: "bg-mist-500" },
  { name: "mist-600", hex: "#56636A", oklch: "oklch(45% 0.017 213.2)", swatch: "bg-mist-600" },
  { name: "mist-700", hex: "#445258", oklch: "oklch(37.8% 0.015 216)", swatch: "bg-mist-700" },
  { name: "mist-800", hex: "#303A3F", oklch: "oklch(27.5% 0.011 216.9)", swatch: "bg-mist-800" },
  { name: "mist-900", hex: "#222A2F", oklch: "oklch(21.8% 0.008 223.9)", swatch: "bg-mist-900", isPrimary: true },
  { name: "mist-950", hex: "#161B1F", oklch: "oklch(14.8% 0.004 228.8)", swatch: "bg-mist-950", isText: true },
];

// Uso corretto / da evitare
const dos = [
  "Usa il logotipo su sfondi chiari, scuri o neutri della palette Mist.",
  "Mantieni le proporzioni originali, senza alterazioni di scala non uniformi.",
  "Lascia un'area di rispetto pari almeno all'altezza della V del marchio.",
  "Per dimensioni ridotte sotto i 24px usa il marchio, non il logotipo completo.",
];
const donts = [
  "Non ruotare, deformare o aggiungere effetti (ombre, bordi, contorni).",
  "Non ricolorare il logotipo con tinte fuori dalla palette Mist.",
  "Non posizionarlo su immagini o pattern che ne riducono la leggibilità.",
  "Non ricostruire il logotipo a mano: usa sempre i file SVG forniti.",
];

// Naming
const namingRules = [
  {
    rule: "Verbalist",
    note: "Sempre con la V maiuscola, sempre per esteso. Mai \"verbalist\" né \"VERBALIST\".",
  },
  {
    rule: "NUR S.r.l. è l'azienda. Verbalist è il prodotto.",
    note: "NUR sviluppa e gestisce Verbalist. Nei copyright, footer, contratti compare NUR. Nelle CTA, headline, materiali di prodotto compare Verbalist.",
  },
  {
    rule: "Niente sinonimi forzati",
    note: "In un testo Verbalist resta Verbalist. Evita \"la piattaforma\", \"la soluzione\", \"il sistema\" usati come sinonimo per evitare ripetizione.",
  },
];

// Tone of voice
const tovPrinciples = [
  {
    title: "Chiaro per chiunque, mai infantile",
    body:
      "Verbalist parla a marketing manager, founder, copywriter. Lessico tecnico ammesso (SEO, SERP, brief, intent), ma niente claim vuoti né registro esclamativo.",
  },
  {
    title: "Concreto, non vago",
    body:
      "Dire cosa fa la feature, quando interviene, per chi. Verbi all'inizio o frase nominale. 1-2 frasi per descrizione, max 20 parole.",
  },
  {
    title: "Verbalist suggerisce, non decide",
    body:
      "Lo strumento aiuta, propone, segnala. Non sceglie al posto dell'utente. \"Ti suggerisce cosa includere\" è meglio di \"ti dice cosa fare\".",
  },
  {
    title: "Niente segni di scrittura AI",
    body:
      "Niente em-dash —, niente virgolette curve “ ”, niente \"non solo X ma anche Y\", niente parole-tic come \"valorizzare\", \"ridefinire\", \"paesaggio\", \"robusto\", \"perenne\".",
  },
];

const tovExamples = [
  {
    bad: "Verbalist rappresenta la soluzione end-to-end pensata per valorizzare al massimo il tuo content marketing.",
    good: "Verbalist scrive contenuti SEO a partire da SERP e keyword reali.",
  },
  {
    bad: "Una piattaforma robusta che ridefinisce il modo in cui crei contenuti — non solo testi, ma vere strategie.",
    good: "Verbalist ti suggerisce cosa scrivere, in che ordine, e con quali fonti.",
  },
  {
    bad: "L'AI sceglie per te il brief migliore, automaticamente.",
    good: "Verbalist propone un brief: tu decidi cosa tenere e cosa cambiare.",
  },
];

// Pattern di background. Le stripes SVG sono tileable e usano grigi neutri
// (compatibili con Mist). I wallpaper sono port del componente del tema
// Oatmeal-Mist: gradiente + noise generati al volo, niente PNG.
const stripeAssets = [
  { label: "Stripes verticali", file: "stripes-base-vertical.svg", preview: "bg-base-vertical-stripes" },
  { label: "Stripes orizzontali", file: "stripes-base-horizontal.svg", preview: "bg-base-horizontal-stripes" },
];

const wallpapers = [
  { color: "blue", label: "Wallpaper Blue", note: "Gradiente blu/verde acqua + noise" },
  { color: "green", label: "Wallpaper Green", note: "Gradiente verde oliva + noise" },
  { color: "purple", label: "Wallpaper Purple", note: "Gradiente prugna + noise" },
  { color: "brown", label: "Wallpaper Brown", note: "Gradiente terra + noise" },
] as const;

// File aggiuntivi (PNG 512/1024) elencati nella sezione Asset finale
const pngVariants = [
  { label: "Logotipo, scuro, 512×151", file: "verbalist-logotype-dark-512.png" },
  { label: "Logotipo, scuro, 1024×302", file: "verbalist-logotype-dark-1024.png" },
  { label: "Logotipo, chiaro, 512×151", file: "verbalist-logotype-light-512.png" },
  { label: "Logotipo, chiaro, 1024×302", file: "verbalist-logotype-light-1024.png" },
  { label: "Marchio, scuro, 512×512", file: "verbalist-mark-dark-512.png" },
  { label: "Marchio, scuro, 1024×1024", file: "verbalist-mark-dark-1024.png" },
  { label: "Marchio, chiaro, 512×512", file: "verbalist-mark-light-512.png" },
  { label: "Marchio, chiaro, 1024×1024", file: "verbalist-mark-light-1024.png" },
];
---

<BaseLayout seo={seo}>
  <!-- Familjen Grotesk: caricato solo qui (variante Mist della brand page) -->
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <!-- HERO -->
  <section>
    <Wrapper variant="standard" class="relative pt-32 pb-12">
      <Text tag="p" variant="textXS" class="font-mono uppercase tracking-wider text-mist-500">
        Brand kit · Mist
      </Text>
      <Text
        tag="h1"
        variant="displayLG"
        class="mt-4 max-w-3xl tracking-tight text-mist-950 font-familjen text-balance"
      >
        Risorse di brand Verbalist
      </Text>
      <Text tag="p" variant="textBase" class="max-w-2xl mt-4 text-mist-600">
        Pagina di riferimento per chi progetta e produce comunicazione Verbalist:
        fiere, social, presentazioni, materiali stampa. Qui trovi logotipo,
        marchio, palette colori, tipografia, pattern, tono di voce e regole d'uso.
      </Text>
      <div class="flex flex-wrap items-center gap-3 mt-8">
        <Button
          href="/brand/verbalist-brand-kit.zip"
          isLink={true}
          size="xs"
          variant="default"
          class="w-fit"
          download
        >
          Scarica il brand kit (zip)
        </Button>
        <span class="text-xs font-mono text-mist-500">SVG + PNG + pattern · ~31 MB</span>
      </div>
    </Wrapper>
  </section>

  <!-- NAMING -->
  <section class="border-t border-mist-200">
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="flex flex-col gap-2 lg:col-span-1">
          <Text tag="p" variant="textXS" class="font-mono uppercase tracking-wider text-mist-500">
            01 / Naming
          </Text>
          <Text tag="h2" variant="displaySM" class="text-mist-950 font-familjen tracking-tight">
            Come si scrive
          </Text>
          <Text tag="p" variant="textBase" class="text-mist-600">
            Tre regole brevi prima di mostrare il logo. Valgono nei copy, nelle
            slide, nelle email e nei materiali fiera.
          </Text>
        </div>
        <div class="lg:col-span-2 flex flex-col divide-y divide-mist-200 border-t border-b border-mist-200">
          {
            namingRules.map((r) => (
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-6">
                <Text tag="h3" variant="textBase" class="font-medium text-mist-950 sm:col-span-1">
                  {r.rule}
                </Text>
                <p class="text-sm text-mist-600 sm:col-span-2">{r.note}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- LOGO -->
  <section class="border-t border-mist-200">
    <Wrapper variant="standard" class="py-12">
      <div class="flex flex-col gap-2 max-w-2xl">
        <Text tag="p" variant="textXS" class="font-mono uppercase tracking-wider text-mist-500">
          02 / Logo
        </Text>
        <Text tag="h2" variant="displaySM" class="text-mist-950 font-familjen tracking-tight">
          Logotipo e marchio
        </Text>
        <Text tag="p" variant="textBase" class="text-mist-600">
          Il logotipo "Verbalist" è la versione primaria, da preferire ovunque ci
          sia spazio per leggerlo. Il marchio (la V) è la versione ridotta,
          adatta a favicon, avatar, app icon, social profile.
        </Text>
      </div>

      <div class="grid grid-cols-1 mt-8 sm:grid-cols-2 gap-px bg-mist-200 border border-mist-200">
        {
          logoVariants.map((v) => (
            <div class={`flex flex-col ${v.bg}`}>
              <div class={`flex items-center justify-center ${v.text} aspect-[16/9] p-12`}>
                {v.component === "logotype" ? (
                  <Logo class="w-auto h-10 md:h-14" />
                ) : (
                  <LogoMark class="w-auto h-20 md:h-28" />
                )}
              </div>
              <div class={`flex items-center justify-between gap-4 px-4 py-3 border-t ${v.bg === "bg-mist-50" ? "border-mist-200" : "border-mist-800"}`}>
                <div class="flex flex-col">
                  <span class={`text-xs ${v.bg === "bg-mist-50" ? "text-mist-600" : "text-mist-300"}`}>
                    {v.label}
                  </span>
                  <span class={`text-xs font-mono ${v.bg === "bg-mist-50" ? "text-mist-400" : "text-mist-500"}`}>
                    {v.fileName}
                  </span>
                </div>
                <a
                  href={v.download}
                  download
                  class={`text-xs font-medium underline underline-offset-4 decoration-mist-300 hover:decoration-current ${v.text}`}
                >
                  Scarica SVG
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>

  <!-- AREA DI RISPETTO -->
  <section class="border-t border-mist-200">
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="flex flex-col gap-2 lg:col-span-1">
          <Text tag="p" variant="textXS" class="font-mono uppercase tracking-wider text-mist-500">
            03 / Spazi
          </Text>
          <Text tag="h2" variant="displaySM" class="text-mist-950 font-familjen tracking-tight">
            Area di rispetto e dimensione minima
          </Text>
          <Text tag="p" variant="textBase" class="text-mist-600">
            Lascia attorno al logotipo uno spazio libero pari almeno all'altezza
            della V del marchio. Niente testo, immagini o elementi grafici dentro
            quest'area.
          </Text>
          <Text tag="p" variant="textBase" class="mt-2 text-mist-600">
            Dimensione minima consigliata: 96px in larghezza per il logotipo,
            24px per il marchio. Sotto questa soglia usa solo il marchio.
          </Text>
        </div>

        <div class="lg:col-span-2 relative bg-mist-100 border border-mist-200 p-8 sm:p-12 lg:p-16 flex items-center justify-center min-h-[280px] overflow-hidden">
          <!-- Cornice area di rispetto -->
          <div class="relative">
            <div class="absolute -inset-6 sm:-inset-8 border border-dashed border-mist-500/60 pointer-events-none"></div>
            <div class="absolute -top-6 left-1/2 -translate-x-1/2 -translate-y-full text-[10px] font-mono uppercase tracking-wider text-mist-700">
              x
            </div>
            <div class="absolute top-1/2 -left-6 -translate-y-1/2 -translate-x-full text-[10px] font-mono uppercase tracking-wider text-mist-700">
              x
            </div>
            <Logo class="relative w-auto h-10 sm:h-12 text-mist-950" />
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- COLORI -->
  <section class="border-t border-mist-200">
    <Wrapper variant="standard" class="py-12">
      <div class="flex flex-col gap-2 max-w-2xl">
        <Text tag="p" variant="textXS" class="font-mono uppercase tracking-wider text-mist-500">
          04 / Colori
        </Text>
        <Text tag="h2" variant="displaySM" class="text-mist-950 font-familjen tracking-tight">
          Palette
        </Text>
        <Text tag="p" variant="textBase" class="text-mist-600">
          Una sola famiglia: <strong class="text-mist-950">Mist</strong>, undici step
          calibrati in OKLCH. <code class="font-mono text-xs text-mist-700">mist-950</code> è
          il colore di testo principale e di logo scuro,
          <code class="font-mono text-xs text-mist-700">mist-100</code> è la surface
          di pagina. La palette è monocromatica per design — nessun accent
          aggiuntivo. I valori sono in OKLCH nel codice e in HEX per i tool di
          design e stampa.
        </Text>
      </div>

      <!-- Mist palette completa -->
      <div class="mt-12">
        <div class="flex items-baseline justify-between gap-4">
          <Text tag="h3" variant="textBase" class="font-medium text-mist-950">
            Mist · 11 step
          </Text>
          <span class="text-xs font-mono text-mist-500">testo principale: mist-950</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-11 gap-1 mt-4">
          {
            mistPalette.map((c) => (
              <div class="flex flex-col gap-2">
                <div class={`relative aspect-square w-full ${c.swatch} ${c.name === "mist-50" ? "outline outline-mist-200" : ""}`}>
                  {c.isPrimary && (
                    <span class="absolute top-1 left-1 text-[9px] font-mono uppercase tracking-wider text-white/80">
                      primario
                    </span>
                  )}
                  {c.isText && (
                    <span class="absolute top-1 left-1 text-[9px] font-mono uppercase tracking-wider text-white/80">
                      testo
                    </span>
                  )}
                </div>
                <div class="flex flex-col">
                  <span class="text-xs font-medium text-mist-950">{c.name}</span>
                  <span class="text-[11px] font-mono text-mist-600">{c.hex}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Uso semantico -->
      <div class="mt-12">
        <Text tag="h3" variant="textBase" class="font-medium text-mist-950">
          Uso semantico (estratto)
        </Text>
        <div class="flex flex-col mt-4 divide-y divide-mist-200 border-t border-b border-mist-200">
          <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-6">
            <span class="font-mono text-sm text-mist-950">mist-100</span>
            <span class="text-sm text-mist-600 sm:col-span-2">Surface di pagina (light mode), area editoriale.</span>
          </div>
          <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-6">
            <span class="font-mono text-sm text-mist-950">mist-200 / mist-300</span>
            <span class="text-sm text-mist-600 sm:col-span-2">Border, separatori, divider chiari.</span>
          </div>
          <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-6">
            <span class="font-mono text-sm text-mist-950">mist-500 / mist-600</span>
            <span class="text-sm text-mist-600 sm:col-span-2">Testo secondario, eyebrow, metadata, placeholder.</span>
          </div>
          <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-6">
            <span class="font-mono text-sm text-mist-950">mist-700</span>
            <span class="text-sm text-mist-600 sm:col-span-2">Testo body in light mode.</span>
          </div>
          <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-6">
            <span class="font-mono text-sm text-mist-950">mist-900 / mist-950</span>
            <span class="text-sm text-mist-600 sm:col-span-2">Foreground principale, surface scura, CTA primaria.</span>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- PATTERN -->
  <section class="border-t border-mist-200">
    <Wrapper variant="standard" class="py-12">
      <div class="flex flex-col gap-2 max-w-2xl">
        <Text tag="p" variant="textXS" class="font-mono uppercase tracking-wider text-mist-500">
          05 / Pattern
        </Text>
        <Text tag="h2" variant="displaySM" class="text-mist-950 font-familjen tracking-tight">
          Pattern di background
        </Text>
        <Text tag="p" variant="textBase" class="text-mist-600">
          Due famiglie di pattern. Le <strong class="text-mist-950">stripes</strong>
          sono SVG vettoriali tileable, usabili come trama leggera. I
          <strong class="text-mist-950">wallpaper</strong> sono backdrop pieni
          (gradiente + noise) pensati per stare dietro a screenshot, hero,
          social card. Generati a runtime: niente file pesanti da scaricare,
          niente JPEG compresso. Coerenti col tema "Oatmeal Mist".
        </Text>
      </div>

      <!-- Wallpaper -->
      <div class="mt-8">
        <div class="flex items-baseline justify-between gap-4">
          <Text tag="h3" variant="textBase" class="font-medium text-mist-950">
            Wallpaper (gradiente + noise)
          </Text>
          <span class="text-xs font-mono text-mist-500">CSS + SVG inline</span>
        </div>
        <div class="grid grid-cols-1 mt-4 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-mist-200 border border-mist-200">
          {
            wallpapers.map((w) => (
              <div class="flex flex-col bg-mist-50">
                <Wallpaper color={w.color} class="aspect-[4/3] w-full" />
                <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-mist-200">
                  <div class="flex flex-col min-w-0">
                    <span class="text-xs text-mist-600 truncate">{w.label}</span>
                    <span class="text-[11px] font-mono text-mist-400 truncate">{w.note}</span>
                  </div>
                  <span class="text-[11px] font-mono text-mist-950 shrink-0">
                    color="{w.color}"
                  </span>
                </div>
              </div>
            ))
          }
        </div>
        <p class="mt-3 text-xs text-mist-500">
          Uso: <code class="font-mono text-mist-700">{`<Wallpaper color="blue" class="aspect-video" />`}</code>
        </p>
      </div>

      <!-- Wallpaper applicato a uno screenshot -->
      <div class="mt-12">
        <div class="flex items-baseline justify-between gap-4">
          <Text tag="h3" variant="textBase" class="font-medium text-mist-950">
            Esempio · screenshot dentro il wallpaper
          </Text>
          <span class="text-xs font-mono text-mist-500">"Oatmeal Mist" hero</span>
        </div>
        <div class="mt-4 border border-mist-200">
          <Wallpaper color="blue" class="p-8 sm:p-12 lg:p-16">
            <div class="mx-auto max-w-3xl bg-mist-50 ring-1 ring-mist-950/10 rounded-sm aspect-[16/9] flex items-center justify-center">
              <Logo class="w-auto h-8 sm:h-10 text-mist-950" />
            </div>
          </Wallpaper>
        </div>
      </div>

      <!-- Stripes -->
      <div class="mt-12">
        <div class="flex items-baseline justify-between gap-4">
          <Text tag="h3" variant="textBase" class="font-medium text-mist-950">
            Stripes (SVG)
          </Text>
          <span class="text-xs font-mono text-mist-500">tileable</span>
        </div>
        <div class="grid grid-cols-1 mt-4 sm:grid-cols-2 gap-px bg-mist-200 border border-mist-200">
          {
            stripeAssets.map((s) => (
              <div class="flex flex-col bg-mist-50">
                <div class={`aspect-[4/3] w-full ${s.preview}`} />
                <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-mist-200">
                  <div class="flex flex-col">
                    <span class="text-xs text-mist-600">{s.label}</span>
                    <span class="text-[11px] font-mono text-mist-400">{s.file}</span>
                  </div>
                  <a
                    href={`/brand/patterns/${s.file}`}
                    download
                    class="text-xs font-medium text-mist-950 underline decoration-mist-300 underline-offset-4 hover:decoration-mist-950"
                  >
                    SVG
                  </a>
                </div>
              </div>
            ))
          }
        </div>
