---
// Foundations
import "../styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";

// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
interface Props {
  seo?: {
    title?: string;
    description?: string;
    image?: { url: string; alt?: string };
    type?: "website" | "article";
    publishedTime?: string;
    noindex?: boolean;
  };
  hideNavigation?: boolean;
  hideFooter?: boolean;
}

// Hides th
// Hides nav and footer on selected screens by passing
// the hideNav and hideFooter props
// <BaseLayout hideNav={true} hideFooter={true}>
const { seo, hideNav = false, hideFooter = false } = Astro.props;
---

<html
  lang="it"
  class="scroll-smooth selection:bg-accent-100 selection:text-accent-900"
>
  <head>
    <BaseHead seo={seo} />
    <slot name="head-extra" />
  </head>
  <body class="relative flex flex-col py-16 bg-base-50 min-h-svh lg:py-25">
    {!hideNav && <Navigation />}
    <div class="w-full max-w-6xl mx-auto border-b xl:border-x border-base-200">
      <main>
        <slot />
      </main>
    </div>

    {!hideFooter && <Footer />}
  </body>
</html>
