---
// Assets
import { Image } from "astro:assets";
import StripesBG from "@/components/assets/StripesBG.astro";
// Fundations
import BaseLayout from "./BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
const { frontmatter } = Astro.props;
const demoUrl = "https://share-eu1.hsforms.com/1QmfwKDraSVOGP3_N6WSMHAft3vh";
---

<BaseLayout>
  <section>
    <Wrapper
      variant="paddinglessDesktop"
      class="relative pt-48 lg:pt-40 overflow-hidden"
    >
      <StripesBG
        variant="base"
        class="absolute inset-0 h-24 p-20 -mx-px border-b border-base-200"
      />
      <div class="relative grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="text-balance lg:p-8">
          <Image
            width={300}
            height={300}
            src={frontmatter.logo.url}
            alt={frontmatter.logo.alt}
            class="inline-block size-6"
          />
          <Text tag="h1" variant="textBase" class="text-base-950 mt-12">
            {frontmatter.name}
          </Text>
          <Text tag="p" variant="textSM" class="mt-4 text-base-600">
            {frontmatter.description}
          </Text>

          <dl class="flex flex-col mt-8 divide-y divide-base-200">
            {
              frontmatter.details.map((detail: { title: string; value: string; url?: string }) => (
                <div class="flex items-center justify-between py-2 gap-2">
                  <dt>
                    <Text
                      tag="h4"
                      variant="textSM"
                      class="font-medium text-base-950"
                    >
                      {detail.title}
                    </Text>
                  </dt>
                  <dd>
                    <Text
                      tag="p"
                      variant="textSM"
                      class="text-base-600 lg:text-balance"
                    >
                      {detail.url ? (
                        <a
                          class="text-base-950 hover:text-base-600 duration-300"
                          href={detail.url}
                        >
                          {detail.value}
                        </a>
                      ) : (
                        detail.value
                      )}
                    </Text>
                  </dd>
                </div>
              ))
            }
          </dl>

          <Button
            isLink={true}
            size="xs"
            variant="muted"
            href={demoUrl}
            class="mt-8 w-fit"
          >
            Prenota demo
          </Button>
        </div>

        <Wrapper
          variant="prose"
          class="lg:col-span-2 lg:border-l lg:border-base-200 lg:p-8"
          ><slot /></Wrapper
        >
      </div>
    </Wrapper>
  </section>
</BaseLayout>
